# Supabase (PoC: free tier project, local-first)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Token encryption (AES-256-GCM key, FSD §8/§10) — generate locally, never commit
TOKEN_ENC_KEY=

# Platform OAuth apps — dev credentials only during PoC (FSD §14: own accounts, self-serve dev mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID_IG=
META_APP_SECRET_IG=
META_APP_ID_FB=
META_APP_SECRET_FB=

# Cron auth (used post-PoC by GitHub Actions -> /api/cron/snapshot)
CRON_SECRET=
