# Supabase (PoC: free tier project, local-first)
# publishable key is browser-safe; secret key bypasses RLS — server-side only
NEXT_PUBLIC_SUPABASE_URL=https://mttdettjxqrpybtvrmnt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_R237fVW04jdK_PaOOXDfrg_JHSEZbwl
SUPABASE_SECRET_KEY=sb_secret_9l0Bj78whIv35OC37s6P9g_3G8tFwcr

# Token encryption (AES-256-GCM key, FSD §8/§10) — generate locally, never commit
TOKEN_ENC_KEY=

# Session/cookie signing secret (post-PoC checklist §4)
APP_SECRET=

# Platform OAuth apps — dev credentials only during PoC (FSD §14: own accounts, self-serve dev mode)
# Google client is unpublished (consent screen in Testing): add teammates as test users in the
# Google Cloud console before they can connect, otherwise consent fails with 403 access_denied.
GOOGLE_CLIENT_ID=902368823930-hc1n6edabil2ov74umgfpifiieqm1aqp.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TikTok strictly enforces HTTPS redirect URIs
TIKTOK_REDIRECT_URI=
# Instagram Login: use Instagram App ID & Secret from Instagram product tab (not parent Meta app)
META_IG_CLIENT_ID=
META_IG_CLIENT_SECRET=
META_IG_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback
# Facebook (Meta app #2 — separate from IG): Page admin required; dev mode requires app role
META_FB_CLIENT_ID=
META_FB_CLIENT_SECRET=
META_FB_REDIRECT_URI=http://localhost:3000/api/auth/facebook/callback
# Leave blank for standard Facebook Login; set only if using Facebook Login for Business configuration
META_FB_CONFIG_ID=

# Meta Graph API version pin (post-PoC checklist §4)
META_GRAPH_VERSION=v21.0

# Cron auth (used post-PoC by GitHub Actions -> /api/cron/snapshot)
CRON_SECRET=

# Feature flags
# Flag-gate Meta (Instagram/Facebook) until App Review & Business Verification approval (FSD §14)
# Defaults to true in development, false in production
ENABLE_META=true
